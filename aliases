#Show all jobs
#qstat -j <jobid> | grep ESK_flow
#qquota | grep project | grep e00114
alias slotp 'qquota | grep project | grep '
alias qlimit 'qconf -srqs project_slot_limits | grep user'
alias sql 'qconf -sql'
alias lj "setenv SGE_LONG_JOB_NAMES -1"
alias ua "qstat -u $USER | awk '{print $4 }' | sort | uniq -c | sort -nr"
#Show how many jobs each user is running right now
alias ur "qstat -u $USER | grep -v 'qw' | awk '{print $4 }' | sort | uniq -c | sort -nr"
#shows pending jobs, which is all those with state "qw" and "hqw" - upend
alias upend 'qstat -s p'
#check slot of qa on UGE
alias qaav 'qquota | gi qa'
##=====
#Switch jobs to qa - swqa <job_ID>
alias swqa 'qalter -q qa'
#Show numbers of jobs in queues - uq
alias uq 'qstat -g c'
#Show number of used slots of all projects in project queue - uus
alias uused 'qquota -q project'
#Show job slot limits for projects in project queue - ujs
alias ujs 'qconf -srqs project_slot_limits'
#Show list of host groups - uhqa
alias uhqa 'qconf -shgrp @QA'
#see status of jobs
alias uex 'qstat -explain c -j'
